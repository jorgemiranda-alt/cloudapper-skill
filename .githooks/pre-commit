#!/bin/sh
# Blocks commits that fail the skill checks. Enable once per clone: git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel)
for c in python3 python py; do
  if "$c" -c "" >/dev/null 2>&1; then py=$c; break; fi
done
if [ -z "$py" ]; then
  echo "pre-commit: Python not found; skill checks skipped. Install Python 3 or run them in CI." >&2
  exit 0
fi
"$py" "$root/scripts/check_skill.py" --root "$root" || {
  echo "Commit blocked by scripts/check_skill.py. See CONTRIBUTING.md." >&2
  exit 1
}
